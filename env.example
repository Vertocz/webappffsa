# Supabase : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret de chiffrement des signalements (serveur uniquement, SANS préfixe NEXT_PUBLIC_).
# Générer avec : openssl rand -base64 32
# À sauvegarder dans un gestionnaire de mots de passe : perdue ou modifiée,
# elle rend les signalements existants illisibles.
ENCRYPTION_KEY=
